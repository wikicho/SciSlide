{
  "name": "scislide",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src tests desktop scripts index.html vite.config.ts vitest.config.ts tsconfig.json package.json README.md",
    "desktop": "pnpm build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:package": "pnpm build && node scripts/package-desktop.mjs",
    "test:desktop": "node --test --test-isolation=none desktop/host-utils.test.cjs tests/desktop-tex.test.mjs tests/desktop-package.test.mjs tests/windows-package.test.mjs tests/desktop-ai.test.mjs",
    "desktop:package:mac": "pnpm build && node scripts/package-macos.mjs",
    "desktop:package:win": "pnpm build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@mathjax/mathjax-fira-font": "^4.0.0",
    "@mathjax/mathjax-modern-font": "^4.0.0",
    "@mathjax/mathjax-stix2-font": "^4.0.0",
    "@mathjax/src": "^4.0.0",
    "dompurify": "^3.2.0",
    "jspdf": "^3.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svg2pdf.js": "^2.5.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.5.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "@electron/osx-sign": "2.7.1"
  },
  "packageManager": "pnpm@11.25.0",
  "main": "desktop/main.cjs",
  "description": "Scientific presentation editor with MathJax and installed LaTeX support"
}
